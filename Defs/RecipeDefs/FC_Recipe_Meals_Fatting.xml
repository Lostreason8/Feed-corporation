  <RecipeDef ParentName="CookMealBase">
    <defName>CookMealPigFeed</defName>
    <label>cook pig feed</label>
    <description>Cook a pig feed.</description>
	<soundWorking>Recipe_CookMeal</soundWorking>
	<effectWorking>Cook</effectWorking>
	<recipeUsers>
		<li>ElectricStove</li>
		<li>FueledStove</li>
	</recipeUsers>	
	<fixedIngredientFilter>
		<disallowedCategories>
			<li>MeatRaw</li>
		</disallowedCategories>
    </fixedIngredientFilter>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>10.0</count>
      </li>
    </ingredients>
    <products>
      <PigFeed>1</PigFeed>
    </products>
  </RecipeDef>
  
