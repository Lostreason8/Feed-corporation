      <saturation>0.9</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.92,0.74,0.62)</sky>
      <shadow>(0.90,0.82,0.78)</shadow>
      <overlay>(0.50,0.33,0.26)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.33,0.27,0.26)</sky>
      <shadow>(0.90,0.82,0.80)</shadow>
      <overlay>(0.40,0.27,0.22)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.33,0.27,0.26)</sky>
      <shadow>(0.90,0.82,0.80)</shadow>
      <overlay>(0.40,0.27,0.22)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightMid>
  </WeatherDef>

</Defs>
