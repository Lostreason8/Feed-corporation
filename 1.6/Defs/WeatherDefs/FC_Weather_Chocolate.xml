<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Шоколадный дождь (копия ванильного дождя с шоколадными цветами) -->
  <WeatherDef>
    <defName>FC_ChocolateRain</defName>
    <label>chocolate rain</label>
    <description>Warm melted chocolate falls from the sky. Anyone caught in it outdoors slowly gains weight.</description>
    <temperatureRange>0~100</temperatureRange>
    <windSpeedFactor>1.2</windSpeedFactor>
    <accuracyMultiplier>0.9</accuracyMultiplier>
    <favorability>Neutral</favorability>
    <perceivePriority>1</perceivePriority>
    <rainRate>1</rainRate>
	<durationRange>16000~32000</durationRange>
    <moveSpeedMultiplier>0.95</moveSpeedMultiplier>
    <ambientSounds>
      <li>Ambient_Rain</li>
    </ambientSounds>
    <overlayClasses>
      <li>WeatherOverlay_Rain</li>
    </overlayClasses>
    <commonalityRainfallFactor>
      <points>
        <li>(0, 0)</li>
        <li>(1300, 1)</li>
        <li>(4000, 3.0)</li>
      </points>
    </commonalityRainfallFactor>
    <skyColorsDay>
      <sky>(0.78,0.62,0.52)</sky>
      <shadow>(0.90,0.82,0.78)</shadow>
      <overlay>(0.55,0.36,0.28)</overlay>
      <saturation>0.95</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.95,0.75,0.62)</sky>
      <shadow>(0.90,0.82,0.78)</shadow>
      <overlay>(0.50,0.32,0.25)</overlay>
      <saturation>0.95</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.34,0.27,0.26)</sky>
      <shadow>(0.90,0.82,0.80)</shadow>
      <overlay>(0.40,0.27,0.22)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.34,0.27,0.26)</sky>
      <shadow>(0.90,0.82,0.80)</shadow>
      <overlay>(0.40,0.27,0.22)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightMid>
  </WeatherDef>

  <!-- Шоколадный туман (копия ванильного тумана) -->
  <WeatherDef>
    <defName>FC_ChocolateFog</defName>
    <label>chocolate fog</label>
    <description>A thick sweet fog of chocolate vapor. Anyone caught in it outdoors slowly gains weight, but more slowly than in chocolate rain.</description>
    <windSpeedFactor>0.5</windSpeedFactor>
    <accuracyMultiplier>0.6</accuracyMultiplier>
    <favorability>Neutral</favorability>
    <perceivePriority>1</perceivePriority>
	<durationRange>16000~32000</durationRange>
    <ambientSounds>
      <li>Ambient_Wind_Fog</li>
    </ambientSounds>
    <overlayClasses>
      <li>WeatherOverlay_Fog</li>
    </overlayClasses>
    <commonalityRainfallFactor>
      <points>
        <li>(0, 0)</li>
        <li>(1300, 1)</li>
      </points>
    </commonalityRainfallFactor>
    <skyColorsDay>
      <sky>(0.80,0.68,0.60)</sky>
      <shadow>(0.92,0.86,0.82)</shadow>
      <overlay>(0.62,0.44,0.34)</overlay>
      <saturation>0.95</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.98,0.82,0.70)</sky>
      <shadow>(0.92,0.86,0.82)</shadow>
      <overlay>(0.55,0.38,0.30)</overlay>
      <saturation>0.95</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.36,0.30,0.28)</sky>
      <shadow>(0.92,0.86,0.82)</shadow>
      <overlay>(0.45,0.31,0.25)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.36,0.30,0.28)</sky>
      <shadow>(0.92,0.86,0.82)</shadow>
      <overlay>(0.45,0.31,0.25)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightMid>
  </WeatherDef>

  <!-- Шоколадная гроза (ливень с молниями) -->
  <WeatherDef>
    <defName>FC_ChocolateThunderstorm</defName>
    <label>chocolate thunderstorm</label>
    <description>A violent storm pouring thick hot chocolate, with lightning. Anyone caught in it outdoors gains weight faster than in chocolate rain.</description>
    <temperatureRange>0~100</temperatureRange>
    <windSpeedFactor>1.6</windSpeedFactor>
    <accuracyMultiplier>0.8</accuracyMultiplier>
    <favorability>Bad</favorability>
    <perceivePriority>1</perceivePriority>
    <rainRate>1</rainRate>
	<durationRange>16000~32000</durationRange>
    <moveSpeedMultiplier>0.9</moveSpeedMultiplier>
    <ambientSounds>
      <li>Ambient_Rain</li>
    </ambientSounds>
    <overlayClasses>
      <li>WeatherOverlay_Rain</li>
    </overlayClasses>
    <eventMakers>
      <li>
        <averageInterval>850</averageInterval>
        <eventClass>WeatherEvent_LightningStrike</eventClass>
      </li>
      <li>
        <averageInterval>150</averageInterval>
        <eventClass>WeatherEvent_LightningFlash</eventClass>
      </li>
    </eventMakers>
    <commonalityRainfallFactor>
      <points>
        <li>(0, 0)</li>
        <li>(1300, 1)</li>
        <li>(4000, 3.0)</li>
      </points>
    </commonalityRainfallFactor>
    <skyColorsDay>
      <sky>(0.62,0.48,0.40)</sky>
      <shadow>(0.85,0.76,0.72)</shadow>
      <overlay>(0.42,0.27,0.21)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.80,0.62,0.50)</sky>
      <shadow>(0.85,0.76,0.72)</shadow>
      <overlay>(0.40,0.25,0.20)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.28,0.22,0.21)</sky>
      <shadow>(0.85,0.77,0.74)</shadow>
      <overlay>(0.32,0.21,0.17)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.28,0.22,0.21)</sky>
      <shadow>(0.85,0.77,0.74)</shadow>
      <overlay>(0.32,0.21,0.17)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightMid>
  </WeatherDef>

  <!-- Шоколадный дождь с туманом -->
  <WeatherDef>
    <defName>FC_ChocolateFoggyRain</defName>
    <label>chocolate foggy rain</label>
    <description>Chocolate rain mixed with a thick sweet fog. Anyone caught in it outdoors gains weight a bit faster than in plain chocolate rain.</description>
    <temperatureRange>0~100</temperatureRange>
    <windSpeedFactor>0.6</windSpeedFactor>
    <accuracyMultiplier>0.6</accuracyMultiplier>
    <favorability>Neutral</favorability>
    <perceivePriority>1</perceivePriority>
    <rainRate>1</rainRate>
	<durationRange>16000~32000</durationRange>
    <moveSpeedMultiplier>0.95</moveSpeedMultiplier>
    <ambientSounds>
      <li>Ambient_Rain</li>
    </ambientSounds>
    <overlayClasses>
      <li>WeatherOverlay_Rain</li>
      <li>WeatherOverlay_Fog</li>
    </overlayClasses>
    <commonalityRainfallFactor>
      <points>
        <li>(0, 0)</li>
        <li>(1300, 1)</li>
        <li>(4000, 2.0)</li>
