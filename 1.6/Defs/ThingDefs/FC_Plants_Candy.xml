  <ThingDef ParentName="TreeBase">
    <defName>FC_Plant_BlueLollipopTree</defName>
    <label>blue lollipop tree</label>
    <description>A tree with a crown of a giant blue swirled lollipop.</description>
    <graphicData>
      <texPath>Things/Plant/FC_Plant_BlueLollipopTree</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Beauty>2</Beauty>
      <BeautyOutdoors>2</BeautyOutdoors>
    </statBases>
    <plant>
      <growDays>30</growDays>
      <harvestWork>1000</harvestWork>
      <harvestYield>30</harvestYield>
      <harvestedThingDef>WoodLog</harvestedThingDef>
      <choppedThingDef>FC_ChoppedStump</choppedThingDef>
      <smashedThingDef>FC_SmashedStump</smashedThingDef>
      <wildClusterWeight>35</wildClusterWeight>
    </plant>
  </ThingDef>

