      <immatureGraphicPath>Things/Plant/FC_Plant_MedicinalGrass_Immature</immatureGraphicPath>
      <harvestAfterGrowth>0.30</harvestAfterGrowth>
      <growDays>7</growDays>
      <sowWork>800</sowWork>
      <sowMinSkill>8</sowMinSkill>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <wildClusterRadius>4</wildClusterRadius>
      <wildClusterWeight>80</wildClusterWeight>
      <purpose>Health</purpose>
    </plant>
  </ThingDef>

</Defs>
