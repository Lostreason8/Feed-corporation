  <!-- ===== Ягодный куст (копия ванильного Plant_Berry): 2 стадии ===== -->
  <ThingDef ParentName="PlantBase">
    <defName>FC_Plant_JellyDropBush</defName>
    <label>Gelatin belly</label>
    <description>Plant that resembles, um... a fat belly? It's pleasant to the touch and crumbles like dough, releasing a sweet juice that can be harvested.</description>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Nutrition>0.50</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/FC_Plant_JellyDropBush</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shadowData>
        <volume>(0.55, 0.2, 0.2)</volume>
        <offset>(0,0,-0.25)</offset>
      </shadowData>
    </graphicData>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <fillPercent>0.20</fillPercent>
    <pathCost>30</pathCost>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.5</fertilitySensitivity>
      <growDays>6</growDays>
      <immatureGraphicPath>Things/Plant/FC_Plant_JellyDropBush_Immature</immatureGraphicPath>
      <harvestYield>2</harvestYield>
      <harvestWork>250</harvestWork>
      <harvestTag>Standard</harvestTag>
      <harvestAfterGrowth>0.30</harvestAfterGrowth>
      <harvestedThingDef>FC_MucilaginousSubstance</harvestedThingDef>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <wildClusterRadius>5</wildClusterRadius>
      <wildClusterWeight>250</wildClusterWeight>
      <visualSizeRange>0.95~1.7</visualSizeRange>
      <topWindExposure>0.3</topWindExposure>
      <wildOrder>2</wildOrder>
      <purpose>Food</purpose>
    </plant>
  </ThingDef>

  <!-- ===== Лекарственная трава (копия ванильного целебного корня): 2 стадии ===== -->
  <ThingDef ParentName="HealrootBase">
    <defName>FC_Plant_MedicinalGrass</defName>
    <label>medicinal grass</label>
