<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <FactionDef Name="FC_ChefsBase" ParentName="FactionBase">
    <defName>FC_Chefs</defName>
    <label>Chefs</label>
    <description>Chefs love to watch 3 things: fire burning, water flowing, and a sapper's belly growing.</description>
    <pawnSingular>pirate</pawnSingular>
    <pawnsPlural>pirates</pawnsPlural>
    <listOrderPriority>10</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>boss</leaderTitle>
    <factionIconPath>World/WorldObjects/Expanding/FC_Chefs</factionIconPath>
    <factionNameMaker>NamerFactionPirate</factionNameMaker>
    <settlementNameMaker>NamerSettlementPirate</settlementNameMaker>
    <permanentEnemy>true</permanentEnemy>
    <techLevel>Spacer</techLevel>
    <allowedCultures><li>Kriminul</li></allowedCultures>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
    </requiredMemes>
    <allowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">PainIsVirtue</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">FleshPurity</li>
    </allowedMemes>
    <structureMemeWeights>
      <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Ideological>
    </structureMemeWeights>
    <xenotypeSet>
      <xenotypeChances>
        <Pigskin MayRequire="Ludeon.RimWorld.Biotech">0.50</Pigskin>
      </xenotypeChances>
    </xenotypeSet>
    <backstoryFilters>
      <li>
        <categories>
          <li>Pirate</li>
        </categories>
      </li>
    </backstoryFilters>
    <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
    <raidLootMaker>PirateRaidLootMaker</raidLootMaker>
	<raidLootValueFromPointsCurve>
		<points>
			<li>(0,0)</li>
			<li>(1000,100)</li>
			<li>(5000,500)</li>
			<li>(10000,1000)</li>
		</points>
	</raidLootValueFromPointsCurve>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <!-- Normal fights, ranged with melee mix-ins -->
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <FC_Gunner>10</FC_Gunner>
        </options>
      </li>
      <li>
        <!-- Normal fights, melee-only -->
        <kindDef>Combat</kindDef>
        <commonality>30</commonality>
        <disallowedStrategies>
          <li>Siege</li>
        </disallowedStrategies>
        <options>
          <FC_Gunner>10</FC_Gunner>
        </options>
      </li>
      <li>
        <!-- Normal fights, ranged only -->
        <kindDef>Combat</kindDef>
        <commonality>20</commonality>
        <options>
          <FC_Gunner>10</FC_Gunner>
        </options>
      </li>
      <li>
        <!-- Normal fights, explosives with ranged mix-ins -->
        <kindDef>Combat</kindDef>
        <commonality>15</commonality>
        <disallowedStrategies>
          <li>Siege</li>
        </disallowedStrategies>
        <options>
          <FC_Gunner>10</FC_Gunner>
        </options>
      </li>
      <li>
        <!-- Normal fights, snipers only -->
        <kindDef>Combat</kindDef>
        <commonality>10</commonality>
        <options>
          <FC_Gunner>10</FC_Gunner>
        </options>
      </li>
      <li>
        <!-- Normal fights, drifters only (very rare) -->
        <kindDef>Combat</kindDef>
        <commonality>2.5</commonality>
        <maxTotalPoints>1000</maxTotalPoints>
        <options>
          <FC_Gunner>10</FC_Gunner>
        </options>
      </li>
      <li>
        <!-- Base defense, mainly ranged with melee mix-ins -->
        <kindDef>Settlement</kindDef>
        <options>
          <FC_Gunner>10</FC_Gunner>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>60</configurationListOrderPriority>
  </FactionDef>
  
