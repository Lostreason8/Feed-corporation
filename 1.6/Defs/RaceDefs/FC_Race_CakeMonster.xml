<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- ============================================================
	     ШАБЛОН МОНСТРА ИЗ ЕДЫ.  Чтобы сделать нового монстра:
	     1) скопируйте этот файл, 2) замените все "FC_CakeMonster" на новое имя
	     (в defName, race, texPath), 3) поменяйте цифры помеченные [НАСТРОЙКА],
	     4) положите 3 картинки _north/_east/_south в Textures.
	     ============================================================ -->

	<ThingDef ParentName="AnimalThingBase">
		<defName>FC_CakeMonster</defName>
		<label>Сake monster</label>
		<description>A creature made of dough and sugar, aggressively wants to feed pawns for some unknown reason.</description>

		<statBases>
			<MoveSpeed>3.0</MoveSpeed>                      <!-- [НАСТРОЙКА] скорость -->
			<MarketValue>300</MarketValue>
			<ComfyTemperatureMin>-60</ComfyTemperatureMin>
			<ComfyTemperatureMax>60</ComfyTemperatureMax>
			<PainShockThreshold>1000</PainShockThreshold>    <!-- не чувствует боли -->
			<MeleeHitChance>15</MeleeHitChance>
		</statBases>

		<!-- [НАСТРОЙКА] сила откорма за ОДИН удар -->
		<modExtensions>
			<li Class="ToxicRimRound.FC_FeedingExtension">
				<fullnessPerHit>0.40</fullnessPerHit>                <!-- наполнение желудка за удар (~1.0 = примерно полный желудок) -->
				<fullnessLimitFraction>1000.0</fullnessLimitFraction>   <!-- наполнять до этой доли жёсткого предела RimRound -->
				<kilosPerHit>10.0</kilosPerHit>                       <!-- кг веса за удар (с множителями и перками RimRound) -->
				<selfDamagePerHit>2</selfDamagePerHit>               <!-- сколько здоровья туловища теряет монстр за удар -->
				<maxWeightSeverity>0</maxWeightSeverity>             <!-- 0 = без предела веса -->
				<vanishAtHealthPercent>0.18</vanishAtHealthPercent>  <!-- когда масса тела упала до этой доли, монстр исчезает без трупа -->
				<dropThingDefName>cakeFat</dropThingDefName>
				<dropMin>1</dropMin>
				<dropMax>4</dropMax>
			</li>
		</modExtensions>

		<!-- Всегда агрессивен (вместо охоты из-за голода) -->
		<comps>
			<li Class="ToxicRimRound.CompProperties_AlwaysManhunter">
				<aggroRadius>10</aggroRadius>   <!-- нападает, когда человек ближе, клеток -->
				<calmRadius>25</calmRadius>     <!-- успокаивается, когда рядом никого в пределах этого радиуса -->
			</li>
		</comps>

		<tools>
			<li>
				<label>slam</label>
				<capacities><li>FC_Feeding</li></capacities>
				<power>8</power>
				<cooldownTime>1.8</cooldownTime>                     <!-- [НАСТРОЙКА] пауза между ударами, сек -->
				<linkedBodyPartsGroup>FC_BlobBodyGroup</linkedBodyPartsGroup>
			</li>
		</tools>

		<race>
			<body>FC_BlobBody</body>                                   <!-- одно тело, без отдельных частей -->
			<hasCorpse>false</hasCorpse>                              <!-- после смерти ничего не остаётся -->
			<bloodDef IsNull="True" />
			<fleshType>FC_BlobFlesh</fleshType>
			<soundMeleeHitPawn>FC_SwallowHit</soundMeleeHitPawn>
			<soundMeleeMiss>FC_SwallowHit</soundMeleeMiss>
			<predator>true</predator>
			<herdAnimal>false</herdAnimal>
			<baseBodySize>2.0</baseBodySize>                         <!-- [НАСТРОЙКА] размер -->
			<baseHealthScale>1.5</baseHealthScale>                   <!-- [НАСТРОЙКА] здоровье = "запас массы" -->
			<needsRest>false</needsRest>                             <!-- не спит -->
			<foodType>None</foodType>                                <!-- не ест, шкалы еды нет -->
			<wildness>0.95</wildness>
			<trainability>None</trainability>
			<manhunterOnDamageChance>1.0</manhunterOnDamageChance>
			<manhunterOnTameFailChance>1.0</manhunterOnTameFailChance>
			<lifeExpectancy>20</lifeExpectancy>
			<lifeStageAges>
				<li>
					<def>AnimalAdult</def>
					<minAge>0</minAge>
				</li>
			</lifeStageAges>
		</race>
	</ThingDef>

	<PawnKindDef ParentName="AnimalKindBase">
		<defName>FC_CakeMonster</defName>
		<label>cake monster</label>
		<race>FC_CakeMonster</race>
		<combatPower>80</combatPower>                               <!-- [НАСТРОЙКА] сила для набегов -->
		<ecoSystemWeight>0.3</ecoSystemWeight>
		<canArriveManhunter>true</canArriveManhunter>
		<lifeStages>
			<li>
				<bodyGraphicData>
					<texPath>Things/Pawn/Animal/FC_CakeMonster/FC_CakeMonster</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>3.4</drawSize>
				</bodyGraphicData>
				<dessicatedBodyGraphicData>
					<texPath>Things/Pawn/Animal/FC_CakeMonster/Dessicated_FC_CakeMonster</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>3.4</drawSize>
				</dessicatedBodyGraphicData>
			</li>
		</lifeStages>
	</PawnKindDef>

</Defs>
