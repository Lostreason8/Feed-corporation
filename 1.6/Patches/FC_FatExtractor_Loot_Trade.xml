<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- Откачиватель жира: лут в ящиках (шанс ~5%, меняется числом weight) и продажа у торговцев поселений (кроме племён). -->

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingSetMakerDef[defName="MapGen_AncientComplexRoomLoot_Default"]/root/options</xpath>
    <value>
      <li>
        <weight>0.4</weight>
        <thingSetMaker Class="ThingSetMaker_StackCount">
          <fixedParams>
            <filter><thingDefs><li>FC_FatExtractor</li></thingDefs></filter>
            <countRange>1~1</countRange>
          </fixedParams>
        </thingSetMaker>
      </li>
    </value>
    <success>Always</success>
  </Operation>

