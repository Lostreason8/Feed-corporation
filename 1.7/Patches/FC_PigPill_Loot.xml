  <!-- Traders: settlements and caravans (not tribals) sell 1 pill -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="Base_Outlander_Standard" or defName="Base_Pirate_Standard" or defName="Base_Empire_Standard" or starts-with(defName,"Caravan_Outlander") or starts-with(defName,"Visitor_Outlander")]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef">
        <thingDef>FC_PigPill</thingDef>
        <countRange>1~1</countRange>
      </li>
    </value>
    <success>Always</success>
  </Operation>

</Patch>