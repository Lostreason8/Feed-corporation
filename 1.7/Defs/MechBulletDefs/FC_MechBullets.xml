<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- READY TEMPLATE: kilos added by ONE bullet hit, per mechanoid.
       Change only the numbers:
         <kilos>          kg added by one hit
         <durationTicks>  how long the weight stays (60000 = 1 day, 0 = permanent)
       Mechanoids and turrets that are NOT listed here use the default (3 kg, 3600 ticks).
       Names that do not exist in your game (for example a DLC you do not have) are simply ignored.
       Only plain bullets fatten: lasers, flamethrowers and explosions are never affected.
       To add a mod mechanoid or a turret: copy one block, change defName and weaponDefName. -->

  <!-- Pikeman -->
  <ToxicRimRound.MechBulletKilosDef>
    <defName>FC_MechBullet_Mech_Pikeman</defName>
    <weaponDefName>Mech_Pikeman</weaponDefName>
    <kilos>20</kilos>
    <durationTicks>3600</durationTicks>
  </ToxicRimRound.MechBulletKilosDef>

  <!-- Militor -->
