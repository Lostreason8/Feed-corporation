  <!-- ===== Mechanoid cluster turrets (Royalty): auto charge turret, mini-slugger turret, auto mortar, auto inferno turret =====
       "Turret_Auto*" with a star means: every turret whose name starts with Turret_Auto.
       Incendiary (inferno) and explosive (mortar) shells never fatten, so in practice this affects
       the charge and slug turrets. If a turret is not covered, the default (3 kg) is used anyway. -->
  <ToxicRimRound.MechBulletKilosDef>
    <defName>FC_MechBullet_ClusterTurrets</defName>
    <weaponDefName>Turret_Auto*</weaponDefName>
    <kilos>3</kilos>
    <durationTicks>3600</durationTicks>
  </ToxicRimRound.MechBulletKilosDef>

</Defs>
